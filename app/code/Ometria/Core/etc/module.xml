<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Ometria_Core" setup_version="2.7.0">
        <!-- Magento_Quote declares the `quote` table that etc/db_schema.xml extends, so the
             sequence is what makes the schema merge order defined rather than incidental. -->
        <sequence>
            <module name="Magento_Quote"/>
        </sequence>
    </module>
</config>
